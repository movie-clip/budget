<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:mvp="using:HomeCharts.Presentation.Mvp"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="HomeCharts.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="mvp:MainWindowViewModel"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        Background="#0B1020"
        Title="Budget Dashboard Preview"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="220,*" RowDefinitions="*">
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="16">
            <StackPanel Spacing="14">
                <TextBlock Text="HOME CHARTS" FontWeight="Bold" FontSize="18" Foreground="#E2E8F0" Margin="0,4,0,16"/>

                <Grid ColumnDefinitions="4,*" ColumnSpacing="8">
                    <Border Background="#3B82F6" CornerRadius="2" IsVisible="{Binding IsDashboardViewSelected}"/>
                    <Button Grid.Column="1" Content="Dashboard"
                        Command="{Binding ShowDashboardViewCommand}"
                        Background="#111827"
                        Foreground="#CBD5E1"
                        HorizontalContentAlignment="Left"
                        CornerRadius="10"
                        Padding="12,10" />
                </Grid>
                <Grid ColumnDefinitions="4,*" ColumnSpacing="8">
                    <Border Background="#3B82F6" CornerRadius="2" IsVisible="{Binding IsImportFiltersViewSelected}"/>
                    <Button Grid.Column="1" Content="Import"
                    Command="{Binding ShowImportFiltersViewCommand}"
                    Background="#111827"
                    Foreground="#CBD5E1"
                    HorizontalContentAlignment="Left"
                    CornerRadius="10"
                    Padding="12,10" />
                </Grid>
                <Grid ColumnDefinitions="4,*" ColumnSpacing="8">
                    <Border Background="#3B82F6" CornerRadius="2" IsVisible="{Binding IsLedgerViewSelected}"/>
                    <Button Grid.Column="1" Content="Transactions"
                        Command="{Binding ShowLedgerViewCommand}"
                        Background="#111827"
                        Foreground="#CBD5E1"
                        HorizontalContentAlignment="Left"
                        CornerRadius="10"
                        Padding="12,10" />
                </Grid>
                <Grid ColumnDefinitions="4,*" ColumnSpacing="8">
                    <Border Background="#3B82F6" CornerRadius="2" IsVisible="{Binding IsUtilityViewSelected}"/>
                    <Button Grid.Column="1" Content="Utility"
                        Command="{Binding ShowUtilityViewCommand}"
                        Background="#111827"
                        Foreground="#CBD5E1"
                        HorizontalContentAlignment="Left"
                        CornerRadius="10"
                        Padding="12,10" />
                </Grid>

                <Border Background="#0B1223" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,20,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Quick Actions" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                        <Button Content="Import Bank File" Background="#2563EB" Foreground="White" Command="{Binding ImportCommand}"/>
                        <Button Content="Refresh" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0" Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="{Binding Status}" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsDashboardViewSelected}">
                <StackPanel>
                    <TextBlock Text="Budget Overview" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Standalone desktop preview · modern finance UX" Foreground="#94A3B8"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Initialize" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Command="{Binding InitializeCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="14" IsVisible="{Binding IsDashboardViewSelected}">
                <Border Background="#111827" CornerRadius="14" Padding="14" BorderBrush="#1F2937" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Income" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding IncomeText, StringFormat='€{0}'}" Foreground="#F8FAFC" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Cash in" Foreground="#22C55E"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#111827" CornerRadius="14" Padding="14" BorderBrush="#1F2937" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Expenses" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding ExpensesText, StringFormat='€{0}'}" Foreground="#F8FAFC" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Cash out" Foreground="#22C55E"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#111827" CornerRadius="14" Padding="14" BorderBrush="#1F2937" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Uncategorized" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding UncategorizedCountText, StringFormat='{}{0} tx'}" Foreground="#F8FAFC" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Review rules" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid ColumnDefinitions="1.6*,1.15*" ColumnSpacing="14" IsVisible="{Binding IsDashboardViewSelected}">
                <Border Background="#111827" CornerRadius="14" BorderBrush="#1F2937" BorderThickness="1" Padding="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Monthly Spending Trend" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TrendRangeText}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" Background="#22C55E" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Text="Income" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" Background="#2563EB" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Text="Expenses" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding TrendChartBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mvp:DashboardTrendBarViewModel">
                                        <StackPanel Width="46" Spacing="8" VerticalAlignment="Bottom">
                                            <Grid Height="260" VerticalAlignment="Bottom">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4" VerticalAlignment="Bottom" Margin="2,0,2,0">
                                                    <Border Background="#22C55E" CornerRadius="4" Height="{Binding IncomeBarHeight}" VerticalAlignment="Bottom"/>
                                                    <Border Grid.Column="1" Background="#2563EB" CornerRadius="4" Height="{Binding ExpensesBarHeight}" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Text="{Binding MonthLabel}" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#111827" CornerRadius="14" BorderBrush="#1F2937" BorderThickness="1" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <TextBlock Text="Expenses" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Category distribution" Foreground="#94A3B8"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ExpenseCategoryBars}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mvp:DashboardExpenseCategoryBarViewModel">
                                        <Grid Margin="0,0,0,8" RowDefinitions="Auto,Auto" RowSpacing="6" HorizontalAlignment="Stretch">
                                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Background="Transparent"
                                                          BorderBrush="Transparent"
                                                          BorderThickness="0"
                                                          Padding="0"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch">
                                                <Border x:Name="ExpenseHeader" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                    <Border.Styles>
                                                        <Style Selector="Border#ExpenseHeader:pointerover">
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="{Binding Category}" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding AmountText, StringFormat='€{0}'}" Foreground="#CBD5E1"/>
                                                        </Grid>
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="10" Foreground="#3B82F6" Background="Transparent"/>
                                                        <TextBlock Text="{Binding Transactions, StringFormat='{}{0} transactions'}" Foreground="#94A3B8" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>
                                            </ToggleButton>

                                            <Border Grid.Row="1" IsVisible="{Binding IsExpanded}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6" Padding="0" HorizontalAlignment="Stretch">
                                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding TransactionItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="mvp:DashboardExpenseTransactionViewModel">
                                                                <Border x:Name="ExpenseTxRow" Background="Transparent" CornerRadius="6" Padding="6,4" Margin="0,0,0,4">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border#ExpenseTxRow:pointerover">
                                                                            <Setter Property="Background" Value="#1E293B"/>
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <Grid ColumnDefinitions="90,*,90" ColumnSpacing="8">
                                                                        <TextBlock Text="{Binding BookingDate}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding AmountText, StringFormat='€{0}'}" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                </Grid>

            <Border Background="#111827" CornerRadius="14" BorderBrush="#1F2937" BorderThickness="1" Padding="16" IsVisible="{Binding IsImportFiltersViewSelected}">
                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="14">
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Import &amp; Search" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding ImportFilePath}" Watermark="Path to bank file..."/>
                                <Button Content="Browse..." Click="OnBrowseImportFileClick" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                                <TextBlock Text="Selecting a file will import it and apply current rules automatically." Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Import Status" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastImportSummary}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LastImportDetails}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LastImportWarningBreakdown}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" MinWidth="180">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Rules Actions" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"/>
                                <Button Content="Clear All Rules"
                                    Click="OnClearAllRulesClick"
                                        Background="#7F1D1D"
                                        Foreground="White"
                                        BorderBrush="#B91C1C" />
                                <TextBlock Text="Deletes all existing categorization rules." Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="14">
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Potential New Rules" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding RulesQueueSummary}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Button Content="Refresh Queue" Command="{Binding RefreshRulesQueueCommand}" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                                    <Button Content="Prev" Command="{Binding PreviousRulesQueuePageCommand}" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                                    <Button Content="Next" Command="{Binding NextRulesQueuePageCommand}" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                                    <TextBlock Text="{Binding RulesQueuePageInfo}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="230">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <Border Background="#0B1223" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <Grid ColumnDefinitions="120,*,110,200,100" ColumnSpacing="10">
                                                <TextBlock Text="Date" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Description / Match String" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Amount" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="Expense Category" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="Action" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding ImportedRuleTransactions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="mvp:EditableRulesImportedTransactionViewModel">
                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                                            <Grid ColumnDefinitions="120,*,110,200,100" ColumnSpacing="10" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding BookingDateText}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding Description}"
                                                                         Watermark="Type matching string..."
                                                                         Background="#111827"
                                                                         BorderBrush="#334155"
                                                                         Foreground="#E2E8F0"
                                                                         VerticalContentAlignment="Center"
                                                                         Padding="10,6"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="3"
                                                                          ItemsSource="{ReflectionBinding DataContext.ExpenseCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding SelectedCategory}"
                                                                          MinWidth="180"
                                                                          VerticalAlignment="Center">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="mvp:CategoryOptionViewModel">
                                                                            <TextBlock Text="{Binding Name}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <Button Grid.Column="4"
                                                                        Content="Save"
                                                                        Command="{ReflectionBinding DataContext.SavePotentialRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding .}"
                                                                        Background="#2563EB"
                                                                        Foreground="White"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Center"
                                                                        Padding="12,6"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Expenses" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ParsedCategoriesSummary}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ParsedCategoryExpenses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="mvp:ParsedCategoryExpenseViewModel">
                                                <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,120,130" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Category}" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ExpenseAmountText, StringFormat='€{0}'}" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Transactions, StringFormat='{}{0} transactions'}" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Background="#111827" CornerRadius="14" BorderBrush="#1F2937" BorderThickness="1" Padding="16" IsVisible="{Binding IsLedgerViewSelected}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Transactions" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*,Auto,220,250" ColumnSpacing="10">
                            <TextBox Text="{Binding ImportFilePath}" Watermark="Path to bank file..."/>
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseTransactionsFileClick" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                            <Button Grid.Column="2" Content="Merge Matched into Budget" Command="{Binding MergeMatchedTransactionsCommand}" Background="#2563EB" Foreground="White"/>
                            <Button Grid.Column="3" Content="Clean All Transactions" Click="OnClearAllTransactionsClick" Background="#7F1D1D" Foreground="White" BorderBrush="#B91C1C"/>
                        </Grid>

                        <TextBlock Text="{Binding MatchedTransactionsSummary}" Foreground="#94A3B8"/>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" MaxHeight="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding MatchedImportTransactions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="mvp:MatchedImportedTransactionViewModel">
                                            <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="110,*,110,130,140,170" ColumnSpacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BookingDateText}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Category}" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding RuleName}" Foreground="#FDE68A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding SourceAccount}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <WrapPanel Orientation="Horizontal" ItemWidth="170" ItemHeight="34">
                            <TextBox Text="{Binding SearchText}" Watermark="Search text..." MinWidth="180"/>

                            <ComboBox ItemsSource="{Binding DatePresetOptions}"
                                      SelectedItem="{Binding SelectedDatePresetOption}"
                                      MinWidth="170">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="mvp:DatePresetOptionViewModel">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox ItemsSource="{Binding SourceAccountFilterOptions}"
                                      SelectedItem="{Binding SelectedSourceAccountFilter}"
                                      MinWidth="170"/>

                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedFilterCategory}"
                                      MinWidth="170">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="mvp:CategoryOptionViewModel">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBox Text="{Binding MinAmountFilter}" Watermark="Min amount" MinWidth="120"/>
                            <TextBox Text="{Binding MaxAmountFilter}" Watermark="Max amount" MinWidth="120"/>

                            <CheckBox Content="Only uncategorized"
                                      IsChecked="{Binding OnlyUncategorized}"
                                      VerticalAlignment="Center"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply Filters" Command="{Binding ApplyFiltersCommand}" Background="#2563EB" Foreground="White"/>
                            <Button Content="Reset" Command="{Binding ResetTransactionFiltersCommand}" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                            <Button Content="Prev" Command="{Binding PreviousPageCommand}" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                            <Button Content="Next" Command="{Binding NextPageCommand}" Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"/>
                            <TextBlock Text="{Binding PageInfo}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
                        <dg:DataGrid ItemsSource="{Binding LedgerItems}"
                                     SelectedItem="{Binding SelectedLedgerItem}"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     GridLinesVisibility="All"
                                     CanUserSortColumns="True"
                                     MinHeight="280">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Date" Binding="{Binding BookingDateText}" Width="130" />
                                <dg:DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="120" />
                                <dg:DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="170" />
                                <dg:DataGridTextColumn Header="Source" Binding="{Binding SourceAccount}" Width="170" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>

                        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Transaction Details" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Booking: {Binding SelectedTransactionDetail.BookingDate}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="Value: {Binding SelectedTransactionDetail.ValueDate}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="Category: {Binding SelectedTransactionDetail.Category}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="Source: {Binding SelectedTransactionDetail.SourceAccount}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="Amount: {Binding SelectedTransactionDetail.Amount}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="External Ref: {Binding SelectedTransactionDetail.ExternalReference}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="Description" Foreground="#94A3B8" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedTransactionDetail.Description}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <TextBlock Text="Normalized" Foreground="#94A3B8" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedTransactionDetail.NormalizedDescription}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Background="#111827" CornerRadius="14" BorderBrush="#1F2937" BorderThickness="1" Padding="16" IsVisible="{Binding IsUtilityViewSelected}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                    <TextBlock Text="Description Prefix Filters" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold"/>

                    <Grid Grid.Row="1" ColumnDefinitions="*,120" ColumnSpacing="10">
                        <TextBox Text="{Binding NewPrefixFilter}" Watermark="Prefix to hide from displayed descriptions..."/>
                        <Button Grid.Column="1"
                                Content="Add"
                                Command="{Binding AddPrefixFilterCommand}"
                                Background="#2563EB"
                                Foreground="White"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="10" MinHeight="220">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Text="Configured Prefixes" Foreground="#94A3B8" FontWeight="SemiBold"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PrefixFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="mvp:PrefixFilterItemViewModel">
                                            <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,100" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Value}" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Content="Remove"
                                                            Command="{ReflectionBinding DataContext.RemovePrefixFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding .}"
                                                            Background="#7F1D1D"
                                                            Foreground="White"
                                                            BorderBrush="#B91C1C"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="These prefixes are hidden from UI descriptions (transactions and potential rule rows)."
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
