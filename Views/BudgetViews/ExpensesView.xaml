<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Wpf="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:viewModels="clr-namespace:HomeCharts.ViewModels"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:budget="clr-namespace:HomeCharts.Models.Budget"
             x:Class="HomeCharts.Views.BudgetViews.ExpensesView"
             x:Name="Root"
             mc:Ignorable="d" Width="1500" Height="820">

    <ContentControl.DataContext>
        <viewModels:ExpensesViewModel/>
    </ContentControl.DataContext>

    <Grid Margin="0,0,0,3">

        <StackPanel Orientation="Horizontal" Margin="396,5,680,786">
            <DatePicker x:Name="StartDatePicker" Width="120" SelectedDateFormat="Short" Background="#00000000" FirstDayOfWeek="Monday"
                        DisplayDateStart="{Binding StartDate}" DisplayDateEnd="{Binding EndDate}"
                        SelectedDate="{Binding TimeFilter.StartDate}">
                <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar">
                        <Setter Property="DisplayMode" Value="Month"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>
            <DatePicker x:Name="EndDatePicker"   Width="120" Margin="10,0,0,0"
                        DisplayDateStart="{Binding StartDate}" DisplayDateEnd="{Binding EndDate}"
                        SelectedDate="{Binding TimeFilter.EndDate}">

            </DatePicker>
            <RadioButton Style="{StaticResource overviewButton}"
             Tag="{StaticResource color15}"
             IsChecked="False"
             Click="OnFilterClick" Margin="0" VerticalAlignment="Center" Height="25" Width="55">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filter" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource overviewButton}"
                Tag="{StaticResource color15}"
                IsChecked="True"
                Click="OnAllClick" Margin="0" VerticalAlignment="Center" Height="25" Width="55">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="All" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Wpf:PieChart HorizontalAlignment="Left" Height="300" Margin="0,10,0,0" VerticalAlignment="Top" Width="351"
		              DataTooltip="{Binding CategoryExpenseList.LabelPoint}"
		              Series="{Binding CategoryExpenseList.PieSeries}"
                      >

        </Wpf:PieChart>

        <Wpf:CartesianChart HorizontalAlignment="Left" Height="216" Margin="1053,79,0,0" VerticalAlignment="Top" Width="412"
		                    Series="{Binding YTDExpenses}"
                            DataClick="Chart_OnDataClick"
		                    >
            <Wpf:CartesianChart.AxisY>
                <Wpf:Axis>
                    <Wpf:Axis.Separator>
                        <Wpf:Separator StrokeThickness="1"/>
                    </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisY>

            <Wpf:CartesianChart.AxisX>
                <Wpf:Axis Labels="{Binding MonthLabels}" FontFamily="Montserrat" >
                    <Wpf:Axis.Separator>
                        <Wpf:Separator StrokeThickness="0"/>
                    </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisX>

        </Wpf:CartesianChart>

        <Grid Margin="10,328.019,1218.272,10" Width="300" Background="#00000000">

            <ListView Name="SomeListViewList" SelectionMode="Single" Padding="5" Background="#00000000" BorderBrush="#00ABADB3"
			        ItemsSource="{Binding CategoryExpenseList.CategoryExpensesList}"
			        SelectionChanged="SomeListViewList_OnSelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.CanContentScroll="True" d:ItemsSource="{d:SampleData ItemCount=5}">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground"                   Value="{StaticResource plainTextColor1}"/>
                        <Setter Property="FontFamily"                   Value="Montserrat"/>
                        <Setter Property="FontWeight"                   Value="Medium"/>
                        <Setter Property="FontSize"                     Value="13.5"/>
                        <Setter Property="VerticalAlignment"            Value="Center"/>

                        <Setter Property="HorizontalAlignment"          Value="Left"/>
                        <Setter Property="HorizontalContentAlignment"   Value="Left"/>
                        <Setter Property="Padding"                      Value="0"/>
                    </Style>

                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <fa:IconImage Icon="HandHoldingDollar" Style="{StaticResource menuButtonIcon}" Width="30" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="25"/>
                            <TextBlock Text="{Binding Category}" Margin="40,6,0,6" HorizontalAlignment="Left" Width="100"/>
                            <TextBlock Text="{Binding CategoryValue}" Margin="140,6,0,6" HorizontalAlignment="Left" Width="50"/>
                            <TextBlock Text="{Binding CategoryDif}" Margin="210,6,0,6" Width="50" Foreground="{Binding Brush}" HorizontalAlignment="Left"/>

                        </Grid>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </Grid>

        <ListView SelectionMode="Single" Name="ExpensesByCategoryList" Padding="5" Background="#00000000" BorderBrush="#00ABADB3"
                ItemsSource="{Binding CategoryTransactionList.CategoryTransactionList}"
                Margin="335,328,522,0" d:ItemsSource="{d:SampleData ItemCount=5}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.CanContentScroll="True">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{StaticResource plainTextColor1}"/>
                    <Setter Property="FontFamily" Value="Montserrat"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate DataType="budget:CategoryFilterItemModel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="15,0,0,0"/>
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock  Text="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}"    VerticalAlignment="Center" Width="70" TextAlignment="Right"/>
                        <TextBlock  Text="{Binding Vendor}"      VerticalAlignment="Center" Width="314"/>
                        <TextBlock  Text="{Binding Expenses}"                               VerticalAlignment="Center" Width="44" TextAlignment="Right"/>
                        <Button Content="Remove" Style="{StaticResource controlButton}"
                        Command="{Binding DataContext.RemoveTransactionCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        VerticalAlignment="Center" Width="54" Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Wpf:CartesianChart HorizontalAlignment="Left" Height="216" Margin="396,84,0,0" VerticalAlignment="Top" Width="640.228"
		                    Series="{Binding CategoryExpenseList.SelectedCategories}" LegendLocation="Bottom">

            <Wpf:CartesianChart.AxisY>
                <Wpf:Axis Foreground="#FFAAAAAA">
                    <Wpf:Axis.Separator>
                        <Wpf:Separator Opacity="0.195"/>
                    </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisY>

            <Wpf:CartesianChart.AxisX>
                <Wpf:Axis Labels="{Binding CategoryExpenseList.AllLabels}">
                    <Wpf:Axis.Separator>
                        <Wpf:Separator StrokeThickness="0"/>
                    </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisX>

        </Wpf:CartesianChart>

    </Grid>




</UserControl>
