<UserControl x:Class="HomeCharts.Views.Import.ImportExpensesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HomeCharts.Views.Import"
             xmlns:import="clr-namespace:HomeCharts.ViewModels"
             xmlns:budget="clr-namespace:HomeCharts.Models.Budget"
             xmlns:homeCharts="clr-namespace:HomeCharts"
             mc:Ignorable="d" Width="1503.728" Height="819.097">

    <ContentControl.DataContext>
        <import:ImportExpensesViewModel/>
    </ContentControl.DataContext>

    <Grid>

        <Button Content="Import" Click="OnImportClick" Margin="-1314,0,0,763" HorizontalAlignment="Center" Width="106" Height="30" VerticalAlignment="Bottom"/>
        <Button Content="Existing" Click="OnLoadFiltersFromDBClick" Margin="263,0,0,763" HorizontalAlignment="Left" Width="106" Height="30" VerticalAlignment="Bottom"/>

        <ListView SelectionMode="Single" Name="UnFilteredExpensesList" Padding="5" Background="#00000000" BorderBrush="#00ABADB3"
                  ItemsSource="{Binding UnfilteredExpenses}"
                  Margin="10,123.095,10,10">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{StaticResource plainTextColor1}"/>
                    <Setter Property="FontFamily" Value="Montserrat"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>

            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate DataType="budget:CategoryFilterItemModel">

                    <Grid HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="1000" >

                        <TextBlock Text="{Binding Date}" Margin="0,5,0,0" HorizontalAlignment="Left" Width="150"/>
                        <TextBox Text="{Binding Vendor}" Margin="160,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="400"/>
                        <TextBlock Text="{Binding Expenses}" Margin="600,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="80">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- when Expenses == 0, collapse the TextBlock -->
                                        <DataTrigger Binding="{Binding Expenses}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>    
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="620,5,0,0" Background="Black" BorderBrush="#FF646464" Width="150"/>
                        <Button Content="{Binding ActionText}" Style="{StaticResource controlButton}"
						        Command="{Binding DataContext.ActionCommand,
								ElementName=Root}"
						        CommandParameter="{Binding}"
						        Margin="870,5,0,0" Width="80"/>

                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</UserControl>
