<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HomeCharts.Views"
             xmlns:import="clr-namespace:HomeCharts.ViewModels"
             xmlns:dashboard="clr-namespace:HomeCharts.ViewModels.Dashboard"
             xmlns:Wpf="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:converters="clr-namespace:HomeCharts.Converters"
             x:Class="HomeCharts.Views.DashboardView"
             mc:Ignorable="d" 
             Width="1500" Height="820">

    <UserControl.DataContext>
        <dashboard:DashboardViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <converters:SignToBrushConverter
            x:Key="SignToBrush"
            PositiveBrush="{StaticResource labelPositiveColor}"
            NegativeBrush="{StaticResource labelNegativeColor}"/>

        <SolidColorBrush x:Key="ExpensesBrush" Color="{StaticResource negativeColor}"/>
        <SolidColorBrush x:Key="IncomeBrush"   Color="{StaticResource positiveColor}"/>
        
    </UserControl.Resources>

    <Grid>
        <StackPanel x:Name="Header"
                    Orientation="Horizontal" Margin="45,99,874,659">


            <StackPanel Orientation="Vertical" Background="{StaticResource backgroundColor}" Margin="0, 0, 5, 0">
                <Label Content="Total Period Change" Foreground="{StaticResource titleColor}"/>
                <Label Content="{Binding PeriodExpenses.PeriodChange}"
                       Foreground="{Binding PeriodExpenses.PeriodChange, Converter={StaticResource SignToBrush}}" HorizontalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Background="{StaticResource menuButtonActiveColor}" Margin="0, 0, 5, 0">
                <Label Content="Total Period Expenses" Foreground="{StaticResource titleColor}" />
                <Label Content="{Binding PeriodExpenses.PeriodExpenses}"
                       Foreground="{StaticResource labelNegativeColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Background="{StaticResource menuButtonActiveColor}">
                <Label Content="Total Period Income" Foreground="{StaticResource titleColor}"/>
                <Label Content="{Binding PeriodExpenses.PeriodIncome}"
                       Foreground="{Binding PeriodExpenses.PeriodIncome, Converter={StaticResource SignToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </StackPanel>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="45,54,874,737">
            <DatePicker x:Name="StartDatePicker" Width="120" SelectedDateFormat="Short" Background="#00000000" FirstDayOfWeek="Monday"
                DisplayDateStart="{Binding StartDate}" DisplayDateEnd="{Binding EndDate}"
                SelectedDate="{Binding TimeFilter.StartDate}">
                <DatePicker.CalendarStyle>
                    <Style TargetType="{x:Type Calendar}">
                        <Setter Property="DisplayMode" Value="Month"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>
            <DatePicker x:Name="EndDatePicker"   Width="120" Margin="10,0,0,0"
                DisplayDateStart="{Binding StartDate}" DisplayDateEnd="{Binding EndDate}"
                SelectedDate="{Binding TimeFilter.EndDate}"/>
            <RadioButton Style="{StaticResource overviewButton}"
                 Tag="{StaticResource color15}"
                 IsChecked="False"
                 Click="OnFilterClick" Margin="0" VerticalAlignment="Center" Height="25" Width="55">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filter" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource overviewButton}"
                Tag="{StaticResource color15}"
                IsChecked="True"
                Click="OnAllClick" Margin="0" VerticalAlignment="Center" Height="25" Width="55">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="All" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
        
        <Wpf:CartesianChart HorizontalAlignment="Left" Height="216" Margin="750,364,0,0" VerticalAlignment="Top" Width="740"
            Series="{Binding CategoryExpenseList.SelectedCategories}" LegendLocation="Bottom">

            <Wpf:CartesianChart.ChartLegend>
                <Wpf:DefaultLegend Foreground="White">
                    <Wpf:DefaultLegend.ContentTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding Title}"
                                Cursor="Hand"
                                MouseLeftButtonDown="LegendItem_Click">
                            </TextBlock>
                        </DataTemplate>
                    </Wpf:DefaultLegend.ContentTemplate>
                </Wpf:DefaultLegend>
            </Wpf:CartesianChart.ChartLegend>

            <Wpf:CartesianChart.AxisY>
                <Wpf:Axis Foreground="#FFAAAAAA">
                    <Wpf:Axis.Separator>
                        <Wpf:Separator Opacity="0.195"/>
                    </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisY>

            <Wpf:CartesianChart.AxisX>
                <Wpf:Axis Labels="{Binding CategoryExpenseList.AllLabels}">
                    <Wpf:Axis.Separator>
                        <Wpf:Separator StrokeThickness="0"/>
                    </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisX>

        </Wpf:CartesianChart>
        
        <Wpf:CartesianChart HorizontalAlignment="Left" Height="216" Margin="750,79,0,0" VerticalAlignment="Top" Width="715"
            DataClick="Chart_OnDataClick">

            <Wpf:CartesianChart.Series>
                <Wpf:ColumnSeries
                    Title="Expenses"
                    Values="{Binding YTDExpenses[0].Values}"
                    Fill="{StaticResource ExpensesBrush}"
                    Stroke="{StaticResource ExpensesBrush}"
                    ColumnPadding="5"/>
                <Wpf:ColumnSeries
                    Title="Income"
                    Values="{Binding YTDExpenses[1].Values}"
                    Fill="{StaticResource IncomeBrush}"
                    Stroke="{StaticResource IncomeBrush}"
                    ColumnPadding="5"/>
            </Wpf:CartesianChart.Series>

            <Wpf:CartesianChart.AxisX>
                <Wpf:Axis
                      Labels="{Binding MonthLabels}"
                      FontFamily="Montserrat"
                      MaxValue="{Binding MonthLabels.Count}">
                    
                        <Wpf:Axis.Separator>
                            <Wpf:Separator StrokeThickness="0" Step="1"/>
                        </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisX>
            
            <Wpf:CartesianChart.AxisY>
                <Wpf:Axis>
                    <Wpf:Axis.Separator>
                        <Wpf:Separator StrokeThickness="1"/>
                    </Wpf:Axis.Separator>
                </Wpf:Axis>
            </Wpf:CartesianChart.AxisY>

        </Wpf:CartesianChart>
        
        <Wpf:PieChart HorizontalAlignment="Left" Height="300" Margin="310,277,0,0" VerticalAlignment="Top" Width="316"
            DataTooltip="{Binding CategoryExpenseList.LabelPoint}"
            Series="{Binding CategoryExpenseList.PieSeries}"
                      />

        <ListView x:Name="SomeListViewList" SelectionMode="Single" Padding="5" Background="#00000000" BorderBrush="#00ABADB3"
        ItemsSource="{Binding CategoryExpenseList.CategoryExpensesList}"
        SelectionChanged="SomeListViewList_OnSelectionChanged"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.CanContentScroll="True" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,277,1207,0">

            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Foreground"                   Value="{StaticResource plainTextColor1}"/>
                    <Setter Property="FontFamily"                   Value="Montserrat"/>
                    <Setter Property="FontWeight"                   Value="Medium"/>
                    <Setter Property="FontSize"                     Value="13.5"/>
                    <Setter Property="Padding"                      Value="0"/>
                </Style>

            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Grid Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:IconImage Icon="HandHoldingDollar" Style="{StaticResource menuButtonIcon}" Width="30" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="25"/>
                        <TextBlock Text="{Binding Category}" Margin="40,6,0,6" HorizontalAlignment="Left" Width="100"/>
                        <TextBlock Text="{Binding CategoryValue}" Margin="145,0,0,0" HorizontalAlignment="Left" Width="50" VerticalAlignment="Center" TextAlignment="Right"/>
                        <TextBlock Text="{Binding CategoryDif}" Margin="214,0,0,0" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Right"/>

                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</UserControl>
