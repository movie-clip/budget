    <!--Button Colors-->
    <SolidColorBrush x:Key="buttonColor1" Color="#18213F"/>
    <SolidColorBrush x:Key="buttonHoverColor1" Color="#5868E9"/>
    <SolidColorBrush x:Key="buttonHoverColor2" Color="#000000"/>
    <SolidColorBrush x:Key="buttonActiveColor1" Color="#5868E9"/>
    
    <!-- Main Menu Control Buttons -->
    <SolidColorBrush x:Key="menuButtonColor" Color="#18213F"/>
    <SolidColorBrush x:Key="menuButtonHoverColor" Color="#19213F"/>
    <SolidColorBrush x:Key="menuButtonHoverColor2" Color="#000000"/>
    <SolidColorBrush x:Key="menuButtonActiveColor" Color="#19213F"/>
    <SolidColorBrush x:Key="menuButtonTextColor" Color="#7986ED"/>

    
    
    <SolidColorBrush x:Key="titleColor" Color="#7986ED"/>
    <SolidColorBrush x:Key="backgroundColor" Color="#18213F"/>

    <SolidColorBrush x:Key="labelPositiveColor" Color="#00A19A"/>
    <SolidColorBrush x:Key="labelNegativeColor" Color="#FF5555"/>

    <Color x:Key="positiveColor">#00A19A</Color>
    <Color x:Key="negativeColor">#FF5555</Color>
    
    <!--TextBox Colors-->
    <!--Etc-->
    
