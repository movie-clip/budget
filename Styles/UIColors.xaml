    <SolidColorBrush x:Key="colorPositive" Color="#00A19A"/>
    <SolidColorBrush x:Key="colorNegative" Color="#FF5555"/>
    
    <!--Font Colors-->
    <SolidColorBrush x:Key="titleColor1" Color="#94A7C6"/>
    
    <SolidColorBrush x:Key="plainTextColor1" Color="#7986ED"/>
    
    
    <SolidColorBrush x:Key="titleColor2" Color="#D5CFF5"/>
